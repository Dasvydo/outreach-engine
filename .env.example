# outreach-engine, campaign environment.
#
# Copy to .env and fill in. .env is gitignored and must stay that way.
# No secret value belongs in any committed file, this one included.
#
# Nothing in this repo sent anything during the campaign build batch. Every key
# below was absent from that session on purpose. See BLOCKED.md.

# --- Discovery -------------------------------------------------------------
# Google Custom Search, for engine/icp_finder.py. Without both of these the
# finder falls back to fixtures/serp/*.json and says so in its output.
# Free tier is 100 queries a day, which is the real constraint on list volume.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Instantly, cold email, global market only -----------------------------
# Danish addresses are excluded in code and no key changes that.
# Email cannot start before roughly 22 September 2026: the sending domains need
# two to three weeks of mailbox warmup first.
INSTANTLY_API_KEY=
INSTANTLY_CAMPAIGN_ID=

# --- Reply classification --------------------------------------------------
# Only needed for sync_replies.py --classifier=model. The default keyword
# classifier needs no key and no network.
ANTHROPIC_API_KEY=

# --- Campaign ledger, Batch B ----------------------------------------------
# The campaign ledger is a SEPARATE project from the product database.
# Never point this at the product project kngcxwcybozgqgnoweyt.
# engine/ledger.py imports campaign_db and falls back to a logging shim when it
# is not on the path, so this repo runs with or without it.
CAMPAIGN_DB_URL=

# Where the ledger shim keeps its local dedup state when campaign_db is absent.
# Optional. Defaults to .ledger-shim/ in the repo root, which is gitignored.
LEDGER_SHIM_DIR=
